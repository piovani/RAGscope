# Copy to .env (never commit .env)
POSTGRES_USER=ragscope
POSTGRES_PASSWORD=ragscope
POSTGRES_DB=ragscope
DATABASE_URL=postgres://ragscope:ragscope@localhost:5432/ragscope?sslmode=disable

# Embeddings (and later the generator) come from Ollama on the host
OLLAMA_URL=http://localhost:11434

# Reranker (TEI, x86 only)
TEI_RERANK_URL=http://localhost:8082

# LLM providers (set the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
